# The demo app takes the base URL, Bot Name, and API key in the browser.
# This file only configures the optional test notifications panel; see
# "Testing proactive notifications" in README.md. Leave it empty to run without it.

# Agent Studio listener URL whose plugin ends in a `notify` step:
#   https://api.moveworks.ai/webhooks/v1/listeners/{url id}/notify
MW_TEST_LISTENER_URL=
# HMAC-SHA256 secret, when the listener verifies signatures (X-Signature header).
# Secured listeners are not held to the unsecured-listener rate limit.
MW_TEST_LISTENER_SECRET=
# Default recipient: the roster user your API key acts as.
MW_TEST_NOTIFY_EMAIL=
